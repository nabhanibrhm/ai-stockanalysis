# Normalise line endings so the same commit is clean on both WSL and Windows.
# Without this, a file saved by a Windows editor arrives with CRLF and shows the
# whole file as modified on the other machine.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-only helper scripts genuinely need CRLF.
*.bat   text eol=crlf
*.ps1   text eol=crlf

*.db    binary
*.png   binary
*.jpg   binary
*.ico   binary
